# Configure these once in Railway, never in GitHub or the browser.
AUTOCLIPS_GOOGLE_CLIENT_ID=
AUTOCLIPS_GOOGLE_CLIENT_SECRET=
AUTOCLIPS_SESSION_SECRET=
AUTOCLIPS_ALLOWED_EMAILS=
AUTOCLIPS_PUBLIC_URL=
AUTOCLIPS_YOUTUBE_CLIENT_ID=
AUTOCLIPS_YOUTUBE_CLIENT_SECRET=
AUTOCLIPS_DATA_ROOT=/data/autoclips
# Optional, curated links to existing Comfy Cloud workflows. Does not grant
# this app access to the OAuth token from the ChatGPT Comfy Cloud plugin.
AUTOCLIPS_COMFY_WORKFLOWS_JSON=[]
